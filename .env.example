# ─── Nirikshan environment ────────────────────────────────────────────────────
# Copy to .env and fill in. Every var the project will need is listed here.
# Never commit .env.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── Database (§1) ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nirikshan
MONGODB_DB_NAME=nirikshan

# ── Auth (§2) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-bytes-min
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10
SEED_USER_PASSWORD=change-me-locally

# ── Assignment engine (§4, §5) ───────────────────────────────────────────────
# No vars. The knobs (noRepeatCycles, workloadTolerance, maxTravelKmPerDay,
# targetedShare) are per-cycle, not per-deployment: POST /api/cycles writes them
# into InspectionCycle.config, and a cycle is verified by replaying it against
# its own stored config. An env var that could shift engine behaviour would let
# an honest cycle replay as MISMATCH. Defaults: packages/core/constants.js.

# ── Override ledger (§6) ─────────────────────────────────────────────────────
# Hour (UTC) of the nightly Merkle anchor over the ledger. Only the schedule is
# configurable — the chain rules are not, for the same reason the engine knobs
# are not: an anchor a deployment could quietly disable is not an anchor.
MERKLE_ROOT_HOUR_UTC=20

# ── Mobile device attestation (§8) ───────────────────────────────────────────
DEVICE_HMAC_SECRET=change-me-32-bytes-min

# ── Evidence storage — Backblaze B2, originals (§10) ─────────────────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=nirikshan-evidence
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# ── Thumbnails — Cloudinary (thumbnails only, never originals) ───────────────
CLOUDINARY_URL=

# ── Trust score thresholds (§11) ─────────────────────────────────────────────
# No vars. TRUST_THRESHOLDS in packages/core/constants.js. §11 retunes these
# against the 25 fixtures; on a system built to be audited, a threshold change
# belongs in git history, not in an invisible per-deployment override.

# ── ML service (§19, §21) ────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# ── Notifications & escalation (§18) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nirikshan.local
SMS_PROVIDER_KEY=
ESCALATION_CRON=0 2 * * *

# ── Video conferencing — Jitsi (§23) ─────────────────────────────────────────
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_JWT_SECRET=

# ── CCTV / streaming (§22) ───────────────────────────────────────────────────
MEDIAMTX_RTSP_URL=rtsp://localhost:8554/demo
HLS_OUTPUT_DIR=./fixtures/hls
STREAM_FRAME_SAMPLE_SECONDS=10

# ── Dashboard (Vite — must be VITE_ prefixed to reach the browser) ───────────
VITE_API_BASE_URL=http://localhost:4000

# ── Mobile (Expo — must be EXPO_PUBLIC_ prefixed to reach the app) ──────────
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
