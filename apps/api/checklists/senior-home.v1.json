      "title": { "en": "Sanitation & Hygiene", "hi": "स्वच्छता" },
      "items": [
        {
          "id": "bedding-clean",
          "type": "bool",
          "label": { "en": "Bedding clean and changed", "hi": "बिस्तर साफ एवं बदला हुआ है" },
